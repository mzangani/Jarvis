# Copia questo file in ".env" e inserisci la tua chiave API Anthropic.
# Il file .env NON va committato (è già ignorato da .gitignore).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opzionale) Cartella "sicura" (sandbox) entro cui sono confinate le operazioni sui
# file: percorsi al suo esterno vengono rifiutati. È anche la base dei default di
# memoria e log qui sotto. Default se non impostato: ~/Jarvis-Sandbox
# JARVIS_SANDBOX=~/Jarvis-Sandbox

# (Opzionale) Percorso del file SQLite della memoria LUNGA di Jarvis.
# Default se non impostato: ~/Jarvis-Sandbox/jarvis_memory.db
# JARVIS_MEMORY=~/Jarvis-Sandbox/jarvis_memory.db

# (Opzionale) Soglia in TOKEN di input oltre la quale Jarvis compatta (riassume) la
# cronologia della conversazione in corso (memoria BREVE). Default: 40000.
# JARVIS_MAX_TOKENS=40000

# (Opzionale) Percorso del file JSONL su cui Jarvis traccia OGNI tool call (Fase 7a):
# input, output (troncato), durata, esito e rischio. Serve per osservabilità/debug.
# Default se non impostato: ~/Jarvis-Sandbox/jarvis.jsonl
# JARVIS_LOG=~/Jarvis-Sandbox/jarvis.jsonl

# (Opzionale) Robustezza delle chiamate all'API (Fase 7b). L'SDK anthropic RITENTA da
# solo gli errori transitori (rete/timeout, 429 rate limit, 5xx/529 overload) con
# backoff esponenziale. Queste variabili configurano quel comportamento nativo.
#
# Numero massimo di ritentativi automatici dell'SDK sugli errori transitori.
# Default se non impostato: 4.
# JARVIS_API_RETRIES=4
#
# Timeout in SECONDI sull'intera richiesta all'API. Se non impostato, si usa il
# default dell'SDK (già sensato). Impostalo solo se vuoi un tetto più stretto.
# JARVIS_API_TIMEOUT=60

# (Opzionale) Modalità VOCE (Fase 6). Disattivata di default. Mettila a "1" (oppure avvia
# con `python main.py --voce`) per usare Jarvis a voce. Richiede le dipendenze di
# requirements-voice.txt e hardware audio; se mancano, Jarvis ripiega sul testo. Vedi
# la sezione "Voce" del README.
# JARVIS_VOICE=1
