# Copia questo file in ".env" e inserisci la tua chiave API Anthropic.
# Il file .env NON va committato (è già ignorato da .gitignore).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opzionale) Percorso del file SQLite della memoria LUNGA di Jarvis.
# Default se non impostato: ~/Jarvis-Sandbox/jarvis_memory.db
# JARVIS_MEMORY=~/Jarvis-Sandbox/jarvis_memory.db

# (Opzionale) Soglia in TOKEN di input oltre la quale Jarvis compatta (riassume) la
# cronologia della conversazione in corso (memoria BREVE). Default: 40000.
# JARVIS_MAX_TOKENS=40000

# (Opzionale) Percorso del file JSONL su cui Jarvis traccia OGNI tool call (Fase 7a):
# input, output (troncato), durata, esito e rischio. Serve per osservabilità/debug.
# Default se non impostato: ~/Jarvis-Sandbox/jarvis.jsonl
# JARVIS_LOG=~/Jarvis-Sandbox/jarvis.jsonl
